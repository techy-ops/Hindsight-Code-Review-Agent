# ==============================================================================
# AI Code Review Agent - Environment Configuration
# ==============================================================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hindsight Persistent Memory Configuration
# Hindsight server base URL (e.g. local Docker instance or Hindsight Cloud)
HINDSIGHT_BASE_URL=http://localhost:8888
# Optional API key for Hindsight Cloud / secured deployments
HINDSIGHT_API_KEY=
# Memory bank namespace identifier
HINDSIGHT_BANK_ID=code-review-agent
# Enable or disable Hindsight memory integration (true/false)
HINDSIGHT_ENABLED=true
# Timeout in seconds for Hindsight API calls
HINDSIGHT_TIMEOUT=10.0
# Maximum memories to recall per review
HINDSIGHT_MAX_RECALL_RESULTS=5

# Phase 2: Learning, Reflection & Personalization
HINDSIGHT_REFLECT_ENABLED=true
HINDSIGHT_REFLECT_BUDGET=low
HINDSIGHT_MIN_MEMORIES_FOR_REFLECTION=2
HINDSIGHT_DEVELOPER_MEMORY_ENABLED=true
DEFAULT_PROJECT_ID=default-project
